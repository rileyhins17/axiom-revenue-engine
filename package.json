{
  "name": "axiom-revenue-engine",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run build:cloudflare",
    "build:next": "next build --webpack",
    "build:cloudflare": "opennextjs-cloudflare build && node scripts/sanitize-cloudflare-bundle.mjs",
    "preview": "npm run build:cloudflare && wrangler dev --config wrangler.production.jsonc --local",
    "deploy": "node scripts/production-deploy-guard.mjs",
    "deploy:production": "node scripts/production-deploy-guard.mjs",
    "check:safety": "node scripts/check-safety-config.mjs",
    "test": "tsx --test --test-concurrency=1 \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "clean:next-types": "node -e \"const fs=require('fs'); for (const p of ['.next/types','.next/dev/types']) fs.rmSync(p,{recursive:true,force:true});\"",
    "typecheck": "npm run clean:next-types && tsc --noEmit --project tsconfig.typecheck.json",
    "lint": "eslint",
    "postinstall": "patch-package",
    "db:migrate:local": "wrangler d1 migrations apply axiom-ops-omniscient --local --config wrangler.production.jsonc",
    "db:migrate:remote": "node scripts/production-migration-guard.mjs",
    "db:migrate:production": "node scripts/production-migration-guard.mjs",
    "cf:typegen": "wrangler types --config wrangler.production.jsonc --env-file wrangler.typegen.env --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "cf:typegen:check": "wrangler types --config wrangler.production.jsonc --env-file wrangler.typegen.env --env-interface CloudflareEnv ./cloudflare-env.d.ts --check",
    "fcc": "tsx scripts/fcc-campaign.ts"
  },
  "dependencies": {
    "better-auth": "1.6.29",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "next": "16.3.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "patch-package": "^8.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wrangler": "4.140.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26"
    },
    "nanoid": "3.3.18",
    "qs": "6.15.2"
  }
}
