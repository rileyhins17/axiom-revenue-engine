{
  "name": "axiom-revenue-engine",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run build:cloudflare",
    "build:next": "next build --webpack",
    "build:cloudflare": "opennextjs-cloudflare build && node scripts/sanitize-cloudflare-bundle.mjs",
    "preview": "npm run build:cloudflare && wrangler dev",
    "deploy": "node scripts/production-deploy-guard.mjs",
    "deploy:production": "wrangler deploy --env=\"\" --autoconfig false",
    "check:safety": "node scripts/check-safety-config.mjs",
    "worker": "tsx scripts/local-scrape-worker.ts",
    "worker:local": "tsx scripts/local-scrape-worker.ts",
    "test": "tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "test:owner-ui": "tsx scripts/verify-owner-ui-acceptance.ts",
    "clean:next-types": "node -e \"const fs=require('fs'); for (const p of ['.next/types','.next/dev/types']) fs.rmSync(p,{recursive:true,force:true});\"",
    "typecheck": "npm run clean:next-types && tsc --noEmit --project tsconfig.typecheck.json",
    "lint": "eslint",
    "postinstall": "patch-package",
    "db:setup:local": "wrangler d1 migrations apply axiom-ops-omniscient --local",
    "db:migrate:local": "wrangler d1 migrations apply axiom-ops-omniscient --local",
    "db:migrate:remote": "node scripts/production-migration-guard.mjs",
    "db:migrate:production": "wrangler d1 migrations apply axiom-ops-omniscient --remote",
    "cf:typegen": "wrangler types --env-file wrangler.typegen.env --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "cf:typegen:check": "wrangler types --env-file wrangler.typegen.env --env-interface CloudflareEnv ./cloudflare-env.d.ts --check",
    "cf:engine:typegen": "wrangler types --config wrangler.engine.jsonc --env-file wrangler.typegen.env --env-interface RevenueEngineEnv ./src/engine/worker-env.d.ts",
    "cf:engine:typegen:check": "wrangler types --config wrangler.engine.jsonc --env-file wrangler.typegen.env --env-interface RevenueEngineEnv ./src/engine/worker-env.d.ts --check",
    "cf:engine:dev": "wrangler dev --config wrangler.engine.jsonc --local --env-file wrangler.typegen.env",
    "cf:engine:dry-run": "wrangler deploy --config wrangler.engine.jsonc --dry-run --autoconfig false",
    "kw:prepare-import": "tsx scripts/prepare-private-kw-import.ts",
    "kw:plan-persistence": "tsx scripts/plan-private-kw-persistence.ts",
    "kw:materialize-source-workflow": "tsx scripts/materialize-private-kw-source-workflow.ts",
    "kw:execute-assessment": "tsx scripts/execute-private-kw-assessment.ts",
    "kw:prepare-contact-review": "tsx scripts/prepare-private-kw-contact-review.ts",
    "kw:persist-contacts": "tsx scripts/persist-private-kw-contacts.ts"
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.1.2",
    "better-auth": "1.6.29",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "next": "16.3.1",
    "parse5-sax-parser": "8.0.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "patch-package": "^8.0.1",
    "playwright": "1.62.1",
    "tailwindcss": "^4",
    "tsx": "4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wrangler": "4.125.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26"
    },
    "nanoid": "3.3.18",
    "qs": "6.15.2"
  }
}
