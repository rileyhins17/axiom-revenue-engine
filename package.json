{
  "name": "axiom-pipeline-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run build:cloudflare",
    "build:next": "next build --webpack",
    "build:cloudflare": "opennextjs-cloudflare build && node scripts/assert-cloudflare-bundle-private-files.mjs",
    "preview": "npm run build:cloudflare && wrangler dev",
    "deploy": "node scripts/production-deploy-guard.mjs",
    "worker": "tsx scripts/local-scrape-worker.ts",
    "worker:local": "tsx scripts/local-scrape-worker.ts",
    "test": "tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "clean:next-types": "node -e \"const fs=require('fs'); for (const p of ['.next/types','.next/dev/types']) fs.rmSync(p,{recursive:true,force:true});\"",
    "typecheck": "npm run clean:next-types && tsc --noEmit --project tsconfig.typecheck.json",
    "lint": "eslint",
    "postinstall": "patch-package",
    "db:setup:local": "wrangler d1 migrations apply axiom-ops-omniscient --local",
    "db:migrate:local": "wrangler d1 migrations apply axiom-ops-omniscient --local",
    "db:migrate:remote": "node scripts/production-migration-guard.mjs",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.1.2",
    "better-auth": "1.6.29",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "next": "16.3.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "patch-package": "^8.0.1",
    "playwright": "1.62.1",
    "tailwindcss": "^4",
    "tsx": "4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wrangler": "4.123.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26"
    },
    "nanoid": "3.3.18",
    "qs": "6.15.2"
  }
}
