{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "axiom-revenue-engine-console",
  "account_id": "fe468a56a5b8c7f8fc5d39e265c2f791",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "global_fetch_strictly_public"
  ],
  "build": {
    "command": "npm run build:cloudflare",
    "cwd": "."
  },
  "minify": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [],
  "triggers": {
    // Durable schedules remain absent until the matching Workflow phase is
    // explicitly approved. A disabled cron should create zero D1 writes.
    "crons": []
  },
  "vars": {
    "CALLER_V2_ENABLED": "false",
        "CALLER_V2_WORKSPACE_ID": "axiom",
        "CALLER_SYNC_ENABLED": "false",
    "APP_BASE_URL": "https://revenue.getaxiom.ca/",
    "AUTH_ALLOWED_EMAILS": "aidan@getaxiom.ca,riley@getaxiom.ca",
    "AUTH_ADMIN_EMAILS": "aidan@getaxiom.ca,riley@getaxiom.ca",
    "AUTH_ALLOWED_ORIGINS": "https://axiom-revenue-engine-console.aidan-magee2.workers.dev,https://revenue.getaxiom.ca,https://operations.getaxiom.ca",
    "CLOUD_SCRAPE_ENABLED": "false",
    "CLOUD_SCRAPE_TIMEOUT_MS": "840000",
    "CLOUD_SCRAPE_WORKER_NAME": "cloudflare-browser",
    // Detail-page extraction populates websiteDomain + email + the
    // WebsiteAssessment block. The per-target discovery loop in scrape-engine
    // is now wrapped with a 40s outer timeout (commit 461c6244+) plus a
    // 25-listing cap, so a single slow business site can no longer wedge an
    // entire scrape job past CLOUD_SCRAPE_TIMEOUT_MS.
    "CLOUD_SCRAPE_DETAIL_PAGES_ENABLED": "false",
    "RATE_LIMIT_WINDOW_SECONDS": "60",
    "RATE_LIMIT_MAX_AUTH": "50",
    "RATE_LIMIT_MAX_SCRAPE": "20",
    "RATE_LIMIT_MAX_EXPORT": "20",
    "SCRAPE_CONCURRENCY_LIMIT": "1",
    "SCRAPE_TIMEOUT_MS": "1800000",
    // Fail closed. Phase switches are enabled only through an approved rollout;
    // checked-in production defaults never create or send autonomous work.
    "AUTONOMOUS_INTAKE_ENABLED": "false",
    "AUTONOMOUS_QUEUE_ENABLED": "false",
    "AUTONOMOUS_SEND_ENABLED": "false",
    "AUTONOMOUS_DAILY_LEAD_INTAKE_CAP": "0",
    "AUTONOMOUS_MAX_SENDS_PER_DAY": "0",
    "AUTONOMOUS_MAX_FOLLOW_UP_SENDS_PER_DAY": "0",
    "AUTONOMOUS_DOMAIN_COOLDOWN_DAYS": "14"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "axiom-ops-omniscient",
      "database_id": "e42f3d48-5813-4d18-86c4-4471b55aa65e",
      "migrations_dir": "./migrations"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "env": {
    "staging": {
      "services": [],
      "triggers": {
        "crons": []
      },
      "vars": {
        "CALLER_V2_ENABLED": "false",
        "CALLER_V2_WORKSPACE_ID": "axiom",
        "CALLER_SYNC_ENABLED": "false",
        "APP_BASE_URL": "https://axiom-revenue-engine-console-staging.aidan-magee2.workers.dev/",
        "AUTH_ALLOWED_EMAILS": "aidan@getaxiom.ca,riley@getaxiom.ca",
        "AUTH_ADMIN_EMAILS": "aidan@getaxiom.ca,riley@getaxiom.ca",
        "AUTH_ALLOWED_ORIGINS": "https://axiom-revenue-engine-console-staging.aidan-magee2.workers.dev",
        "CLOUD_SCRAPE_ENABLED": "false",
        "CLOUD_SCRAPE_TIMEOUT_MS": "840000",
        "CLOUD_SCRAPE_WORKER_NAME": "cloudflare-browser",
        "CLOUD_SCRAPE_DETAIL_PAGES_ENABLED": "false",
        "RATE_LIMIT_WINDOW_SECONDS": "60",
        "RATE_LIMIT_MAX_AUTH": "50",
        "RATE_LIMIT_MAX_SCRAPE": "20",
        "RATE_LIMIT_MAX_EXPORT": "20",
        "SCRAPE_CONCURRENCY_LIMIT": "1",
        "SCRAPE_TIMEOUT_MS": "1800000",
        "AUTONOMOUS_INTAKE_ENABLED": "false",
        "AUTONOMOUS_QUEUE_ENABLED": "false",
        "AUTONOMOUS_SEND_ENABLED": "false",
        "AUTONOMOUS_DAILY_LEAD_INTAKE_CAP": "0",
        "AUTONOMOUS_MAX_SENDS_PER_DAY": "0",
        "AUTONOMOUS_MAX_FOLLOW_UP_SENDS_PER_DAY": "0",
        "AUTONOMOUS_DOMAIN_COOLDOWN_DAYS": "14"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "axiom-revenue-engine-staging",
          "database_id": "322fcf89-312c-44f0-b238-c4a348f6d6ad",
          "migrations_dir": "./migrations"
        }
      ],
      "browser": {
        "binding": "BROWSER"
      }
    }
  }
}
