# Local development only: copy to .dev.vars for `wrangler dev`. Live values are in
# wrangler.production.jsonc and Cloudflare's secret store.
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
APP_BASE_URL=http://127.0.0.1:8787
AUTH_ALLOWED_EMAILS=founder-one@example.com,founder-two@example.com
AUTH_ADMIN_EMAILS=founder-one@example.com,founder-two@example.com
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:8787
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_MAX_AUTH=10
# FCC_SMTP_PASSWORD and FCC_SMTP_PASSWORD_2 exist only as live secrets. Leave them unset
# locally, so nothing on a laptop can send an FCC email.
