{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "axiom-revenue-engine-core-shadow",
  "main": "src/engine/worker.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  // The inert scaffold has no secrets. Declaring the empty allow-list prevents
  // Wrangler from copying unrelated root .env.local values into local runtime.
  "secrets": {
    "required": []
  },
  "services": [],
  "triggers": {
    "crons": []
  },
  "vars": {
    "ENGINE_ENVIRONMENT": "shadow",
    "ENGINE_EXECUTION_ENABLED": "false",
    "ENGINE_AUTONOMY_LEVEL": "OFF",
    "ENGINE_MAX_JOB_COST_USD": "0"
  },
  // This registers the durable class for local validation only. There is no
  // route, schedule, queue producer, queue consumer, database, or provider
  // credential capable of starting or advancing work.
  "workflows": [
    {
      "binding": "BUSINESS_WORKFLOW",
      "name": "axiom-revenue-engine-business-shadow",
      "class_name": "RevenueBusinessWorkflow",
      "limits": {
        "steps": 2
      }
    }
  ]
}
